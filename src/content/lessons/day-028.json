  "dialogue": {
    "title": "Hoe was je vakantie?",
    "scene": "Tom is back from a holiday in France. Sara wants to hear all about it.",
    "lines": [
      { "speaker": "Sara", "nl": "Hallo Tom! Je bent terug! Hoe was je vakantie?", "en": "Hi Tom! You're back! How was your holiday?", "gap": "terug" },
      { "speaker": "Tom", "nl": "Heel leuk! Ik ben twee weken in Frankrijk geweest.", "en": "Really nice! I was in France for two weeks.", "gap": "geweest" },
      { "speaker": "Sara", "nl": "Ben je gevlogen?", "en": "Did you fly?", "gap": "gevlogen" },
      { "speaker": "Tom", "nl": "Nee, ik ben met de trein gegaan.", "en": "No, I went by train." },
      { "speaker": "Sara", "nl": "En waar heb je geslapen?", "en": "And where did you sleep?" },
      { "speaker": "Tom", "nl": "In een klein hotel dichtbij de zee.", "en": "In a small hotel near the sea.", "gap": "zee" },
      { "speaker": "Sara", "nl": "Ben je veel naar het strand gegaan?", "en": "Did you go to the beach a lot?" },
      { "speaker": "Tom", "nl": "Ja, elke dag. Het weer was heel mooi.", "en": "Yes, every day. The weather was lovely." },
      { "speaker": "Sara", "nl": "Wanneer ben je teruggekomen?", "en": "When did you get back?" },
      { "speaker": "Tom", "nl": "Eergisteren. Ik ben nog moe!", "en": "The day before yesterday. I'm still tired!", "gap": "Eergisteren" }
