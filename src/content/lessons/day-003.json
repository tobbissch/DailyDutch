  "dialogue": {
    "title": "Een brood, alstublieft",
    "scene": "Sara buys bread at the bakery. She uses u — polite with people she doesn't know.",
    "lines": [
      { "speaker": "Bakker", "nl": "Dag! Wat wilt u?", "en": "Hello! What would you like?" },
      { "speaker": "Sara", "nl": "Dag! Ik wil graag een brood, alstublieft.", "en": "Hello! I'd like a loaf of bread, please.", "gap": "graag" },
      { "speaker": "Bakker", "nl": "Een brood. Alstublieft.", "en": "A loaf. Here you are." },
      { "speaker": "Sara", "nl": "Dank u wel. Hoeveel kost het?", "en": "Thank you. How much is it?", "gap": "Hoeveel" },
      { "speaker": "Bakker", "nl": "Het brood kost drie euro.", "en": "The bread is three euros.", "gap": "kost" },
      { "speaker": "Sara", "nl": "Alstublieft.", "en": "Here you are." },
      { "speaker": "Bakker", "nl": "Dank u wel. Dag!", "en": "Thank you. Bye!" }
