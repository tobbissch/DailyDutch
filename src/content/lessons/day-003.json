  "grammar": {
    "title": "de or het?",
    "points": [
      "Dutch has two words for 'the': de and het.",
      "Most nouns are de-words. About one in three is a het-word.",
      "There is no reliable rule — learn every noun together with its article: het brood, de euro.",
      "All plurals take de: het brood → de broden.",
      "een (a/an) is the same for both: een brood, een euro."
    ],
    "examples": [
      { "nl": "het brood", "en": "the bread" },
      { "nl": "de broden", "en": "the loaves" },
      { "nl": "Het brood kost drie euro.", "en": "The bread costs three euros." },
      { "nl": "Ik wil graag een brood.", "en": "I'd like a loaf of bread." }
    ],
    "exercises": [
      { "prompt": "___ brood is goed.", "answer": "Het", "hint": "de / het" },
      { "prompt": "___ broden zijn goed.", "answer": "De", "hint": "de / het" },
