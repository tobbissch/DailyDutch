      { "prompt": "Waar is mijn telefoon? Ik zoek ___.", "answer": "hem", "hint": "de telefoon" }
    ]
  },
  "dialogue": {
    "title": "Bij de huisarts",
    "scene": "Sara feels ill and sees the GP. The doctor uses u, as with any patient.",
    "lines": [
      { "speaker": "Huisarts", "nl": "Dag Sara. Hoe gaat het met u?", "en": "Hello Sara. How are you?" },
      { "speaker": "Sara", "nl": "Niet zo goed. Ik ben ziek.", "en": "Not so good. I'm ill.", "gap": "ziek" },
      { "speaker": "Huisarts", "nl": "Waar heeft u pijn?", "en": "Where does it hurt?", "gap": "pijn" },
      { "speaker": "Sara", "nl": "Ik heb pijn in mijn keel en in mijn hoofd.", "en": "My throat and my head hurt.", "gap": "hoofd" },
      { "speaker": "Huisarts", "nl": "Ik ga in uw keel kijken.", "en": "I'm going to look at your throat." },
      { "speaker": "Huisarts", "nl": "Het is niet slecht. Neem het medicijn in de ochtend en in de avond.", "en": "It's nothing bad. Take the medicine in the morning and in the evening.", "gap": "medicijn" },
      { "speaker": "Sara", "nl": "Moet ik terugkomen?", "en": "Do I need to come back?" },
      { "speaker": "Huisarts", "nl": "Nee. Op vrijdag bel ik u op.", "en": "No. I'll call you on Friday." },
      { "speaker": "Sara", "nl": "Dank u wel, dokter.", "en": "Thank you, doctor." },
      { "speaker": "Huisarts", "nl": "Beterschap!", "en": "Get well soon!", "gap": "Beterschap" }
    ]
  }
