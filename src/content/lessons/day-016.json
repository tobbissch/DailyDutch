      { "speaker": "Sara", "nl": "Eerst douche ik. Daarna ontbijt ik met koffie en brood.", "en": "First I take a shower. After that I have breakfast with coffee and bread.", "gap": "Daarna" },
      { "speaker": "Tom", "nl": "Neem jij je lunch mee?", "en": "Do you bring your lunch?", "gap": "mee" },
