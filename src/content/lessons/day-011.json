  "grammar": {
    "title": "geen or niet?",
    "points": [
      "Use geen (no, not a, not any) with a noun that has een or no article: Ik heb een appel → Ik heb geen appel. Ik eet vlees → Ik eet geen vlees.",
      "Use niet for everything else: verbs, adjectives, and nouns with de, het or mijn: Ik ontbijt niet. Het is niet lekker. Ik lust de vis niet.",
      "niet comes after a noun with de/het (Ik lust de kaas niet) but before an adjective or place (niet lekker, niet in Amsterdam).",
      "honger and dorst go with hebben: Ik heb honger (lit. I have hunger).",
      "lusten = to like (food). It's mostly used with geen or niet: Ik lust geen vis."
    ],
    "examples": [
      { "nl": "Ik heb geen honger.", "en": "I'm not hungry." },
      { "nl": "Sara eet geen vlees.", "en": "Sara doesn't eat meat." },
      { "nl": "Wij hebben geen eieren.", "en": "We don't have any eggs." },
      { "nl": "De kaas is niet lekker.", "en": "The cheese isn't good." },
      { "nl": "Ik lust de vis niet.", "en": "I don't like the fish." }
    ],
