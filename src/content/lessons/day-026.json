  "dialogue": {
    "title": "Een warme jas",
    "scene": "Winter is coming. Sara looks for a warm coat in a clothes shop.",
    "lines": [
      { "speaker": "Verkoopster", "nl": "Dag! Kan ik u helpen?", "en": "Hello! Can I help you?" },
      { "speaker": "Sara", "nl": "Ja, graag. Ik zoek een warme jas.", "en": "Yes, please. I'm looking for a warm coat.", "gap": "jas" },
      { "speaker": "Verkoopster", "nl": "Wat is uw maat?", "en": "What's your size?", "gap": "maat" },
      { "speaker": "Sara", "nl": "Maat achtendertig.", "en": "Size thirty-eight." },
      { "speaker": "Verkoopster", "nl": "Deze zwarte jas is heel warm.", "en": "This black coat is very warm.", "gap": "Deze" },
      { "speaker": "Sara", "nl": "Zwart vind ik niet zo mooi. Heeft u die blauwe jas in maat achtendertig?", "en": "I don't really like black. Do you have that blue coat in size thirty-eight?", "gap": "die" },
      { "speaker": "Verkoopster", "nl": "Ja, hier. Wilt u hem passen?", "en": "Yes, here. Would you like to try it on?", "gap": "passen" },
      { "speaker": "Sara", "nl": "Hij past goed! Hoeveel kost hij?", "en": "It fits well! How much is it?" },
      { "speaker": "Verkoopster", "nl": "Negentig euro.", "en": "Ninety euros." },
      { "speaker": "Sara", "nl": "Dat is duur, maar hij is mooi. Ik neem hem.", "en": "That's expensive, but it's nice. I'll take it." }
    ]
  }
