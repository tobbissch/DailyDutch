    "scene": "Sara chats about the weather with her older neighbour, mevrouw De Vries.",
    "lines": [
      { "speaker": "Mevrouw De Vries", "nl": "Dag Sara! Wat een mooi weer vandaag!", "en": "Hello Sara! What lovely weather today!", "gap": "mooi weer" },
      { "speaker": "Sara", "nl": "Ja, heel mooi! Het is lekker warm.", "en": "Yes, really nice! It's lovely and warm.", "gap": "warm" },
      { "speaker": "Mevrouw De Vries", "nl": "Maar morgen regent het.", "en": "But tomorrow it's going to rain.", "gap": "regent" },
      { "speaker": "Sara", "nl": "Nee! Regen en wind? Wat jammer!", "en": "Oh no! Rain and wind? What a pity!" },
      { "speaker": "Mevrouw De Vries", "nl": "Ja, en het is koud. Het weer in Nederland is altijd slecht!", "en": "Yes, and it'll be cold. The weather in the Netherlands is always bad!", "gap": "slecht" },
      { "speaker": "Sara", "nl": "In Spanje is het niet zo koud.", "en": "In Spain it isn't so cold." },
      { "speaker": "Mevrouw De Vries", "nl": "Ja, Spanje heeft veel zon. Spanje is mooi!", "en": "Yes, Spain gets a lot of sun. Spain is beautiful!" },
      { "speaker": "Sara", "nl": "Maar Nederland is ook heel mooi!", "en": "But the Netherlands is very beautiful too!" }
